<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <mxCell id="title" value="查询检索流程（Query &amp; Retrieval）" style="text;fontSize=18;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
      <mxGeometry x="150" y="10" width="500" height="30" as="geometry"/>
    </mxCell>
    
    <!-- Query Input -->
    <mxCell id="q-input" value="query 输入&#xa;+ query_type&#xa;+ wiki_id&#xa;+ include_pending" style="rounded=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="30" y="60" width="130" height="65" as="geometry"/>
    </mxCell>
    
    <!-- Query Type Classification -->
    <mxCell id="q-classify" value="Query Type 分类&#xa;6 类查询" style="rhombus;fillColor=#fff9c4;strokeColor=#f57f17;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="210" y="60" width="120" height="65" as="geometry"/>
    </mxCell>
    <mxCell id="e-input-classify" style="endArrow=classic;strokeColor=#0277bd;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-input" target="q-classify"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- 6 Query Types -->
    <mxCell id="qt-fact" value="fact" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="380" y="30" width="55" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="qt-concept" value="concept" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="445" y="30" width="60" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="qt-procedure" value="procedure" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="515" y="30" width="65" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="qt-comparison" value="comparison" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="380" y="65" width="70" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="qt-decision" value="decision" style="rounded=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="460" y="65" width="60" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="qt-dispute" value="dispute" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="530" y="65" width="55" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="qt-other" value="other" style="rounded=1;fillColor=#e0e0e0;strokeColor=#757575;fontSize=9;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="595" y="65" width="45" height="25" as="geometry"/>
    </mxCell>
    
    <mxCell id="e-cl-fact" style="endArrow=classic;strokeColor=#2e7d32;strokeWidth=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-classify" target="qt-fact"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e-cl-comp" style="endArrow=classic;strokeColor=#2e7d32;strokeWidth=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-classify" target="qt-comparison"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- Coarse Retrieval -->
    <mxCell id="coarse" value="Coarse Retrieval&#xa;RetrievalProvider.search()&#xa;Phase 1: Lexical&#xa;Optional: Vector" style="rounded=1;fillColor=#c5e1a5;strokeColor=#558b2f;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="120" width="200" height="65" as="geometry"/>
    </mxCell>
    
    <!-- Aggregate by wiki_id:doc_id -->
    <mxCell id="aggregate" value="Aggregate&#xa;by wiki_id:doc_id" style="rounded=1;fillColor=#ffe0b2;strokeColor=#e65100;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="210" width="130" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Full page / section loading -->
    <mxCell id="load" value="整页/Section加载&#xa;cross_refs展开" style="rounded=1;fillColor=#ffe0b2;strokeColor=#e65100;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="275" width="140" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Pending overlay -->
    <mxCell id="pending" value="Pending 叠加&#xa;raw: 可查（默认）&#xa;truth zone: include_pending=true" style="rounded=1;fillColor=#fce4ec;strokeColor=#880e4f;fontStyle=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="550" y="210" width="180" height="45" as="geometry"/>
    </mxCell>
    
    <mxCell id="e-coarse-agg" style="endArrow=classic;strokeColor=#558b2f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="coarse" target="aggregate"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e-agg-load" style="endArrow=classic;strokeColor=#e65100;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="aggregate" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e-agg-pend" style="endArrow=classic;strokeColor=#880e4f;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aggregate" target="pending"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- L1/L2/L3 Output -->
    <mxCell id="l1" value="L1 答案层&#xa;直接回答&#xa;1-3 句话" style="rounded=1;fillColor=#a5d6a7;strokeColor=#2e7d32;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="100" y="350" width="120" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="l2" value="L2 上下文层&#xa;相关页面摘要&#xa;cross_refs 列表" style="rounded=1;fillColor=#c5e1a5;strokeColor=#558b2f;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="260" y="350" width="130" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="l3" value="L3 证据链层&#xa;原始 raw 引用&#xa;source_refs 完整路径" style="rounded=1;fillColor=#e8f5e9;strokeColor=#81c784;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="350" width="150" height="55" as="geometry"/>
    </mxCell>
    
    <mxCell id="e-load-l1" style="endArrow=classic;strokeColor=#2e7d32;strokeWidth=2;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="load" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e-load-l2" style="endArrow=classic;strokeColor=#558b2f;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="load" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e-load-l3" style="endArrow=classic;strokeColor=#81c784;strokeWidth=2;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="load" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- Dispute caveat -->
    <mxCell id="dispute-note" value="⚠️ dispute 类型查询&#xa;标注矛盾来源&#xa;不自动选边" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontStyle=1;fontSize=9;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="620" y="350" width="130" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="e-l3-dispute" style="endArrow=classic;strokeColor=#c62828;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l3" target="dispute-note"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- Feedback loop -->
    <mxCell id="feedback" value="wiki.feedback&#xa;→ review_queue&#xa;（自进化闭环）" style="rounded=1;fillColor=#e1bee7;strokeColor=#7b1fa2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="30" y="450" width="130" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="e-l1-fb" style="endArrow=classic;strokeColor=#7b1fa2;strokeWidth=1.5;dashed=1;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l1" target="feedback"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- Query outcomes -->
    <mxCell id="outcomes" value="query_outcomes 记录&#xa;decision 类：必记&#xa;fact 类：采样" style="rounded=1;fillColor=#e8eaf6;strokeColor=#283593;fontStyle=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="200" y="450" width="130" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="e-l2-out" style="endArrow=classic;strokeColor=#283593;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l2" target="outcomes"><mxGeometry relative="1" as="geometry"/></mxCell>
    
    <!-- Agent capability legend -->
    <mxCell id="agent-legend" value="" style="rounded=1;fillColor=#fafafa;strokeColor=#bdbdbd;" vertex="1" parent="1">
      <mxGeometry x="380" y="440" width="380" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="al1" value="T1 (Hermes/OpenClaw): 全6类查询" style="text;fontSize=9;fillColor=none;strokeColor=none;fontColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="395" y="446" width="200" height="14" as="geometry"/>
    </mxCell>
    <mxCell id="al2" value="T2 (CC): 全6类 + feedback" style="text;fontSize=9;fillColor=none;strokeColor=none;fontColor=#558b2f;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="395" y="462" width="200" height="14" as="geometry"/>
    </mxCell>
    <mxCell id="al3" value="T3 (Codex/OpenCode): fact/concept/procedure + capture_raw" style="text;fontSize=9;fillColor=none;strokeColor=none;fontColor=#757575;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="395" y="478" width="350" height="14" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>