#!/usr/bin/env bash
# aw-codex — agent-wiki CLI wrapper for Codex (A-level, query + capture_raw only)
# Usage: aw-codex query "搜索词"
#        aw-codex capture-raw DOC_ID --topic TOPIC --problem-cluster CLUSTER --content CONTENT
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Override identity for Codex before sourcing common
AW_ACTOR_ID=codex
# shellcheck source=scripts/aw-common.sh
source "$SCRIPT_DIR/aw-common.sh"

exec aw "$@"
